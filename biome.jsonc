{
  // Biome only sorts imports. Prettier formats and oxlint lints (see .oxlintrc.json).
  "$schema": "https://biomejs.dev/schemas/2.5.0/schema.json",
  "files": {
    "includes": [
      "**/test/**",
      "**/packages/**",
      "**/apps/**",
      "**/scripts/**",
      "!**/*.css",
      "!**/*.json",
      // Biome's import sort breaks indentation inside Svelte script blocks.
      "!**/*.svelte",
      "!**/smoke/**",
      "!**/fixtures/**",
      "!**/_temp-fixtures/**",
      "!**/vendor/**",
      "!.local/**",
      "!.agents/**",
      "!.claude/**",
      "!.scratch/**",
      "!scripts/portable-runtime/docs/layered-docs/generated/**",
      "!**/build/**",
      "!**/.astro/**",
      "!**/.wrangler/**",
      "!**/dist/**",
      "!**/node_modules/**",
      "!**/.devin/**"
    ]
  },
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "formatter": { "enabled": false },
  "linter": { "enabled": false },
  "assist": { "actions": { "source": { "organizeImports": "on" } } },
  "json": {
    "parser": {
      "allowComments": true,
      "allowTrailingCommas": false
    }
  }
}

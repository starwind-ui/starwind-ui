{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["eslint", "typescript", "unicorn", "oxc", "import"],
  "categories": {
    "correctness": "error"
  },
  "options": {
    "typeAware": true
  },
  "env": {
    "browser": true,
    "node": true,
    "es2024": true
  },
  "ignorePatterns": [
    "**/dist/**",
    "**/.dist-staging-*/**",
    "apps/svelte-demo/build/**",
    "**/coverage/**",
    "**/.astro/**",
    "**/.svelte-kit/**",
    "**/.turbo/**",
    "**/.wrangler/**",
    "**/node_modules/**",
    ".agent/**",
    ".agents/**",
    ".changeset/**",
    ".claude/**",
    ".devin/**",
    ".local/**",
    ".scratch/**",
    ".tours/**",
    ".windsurf/**",
    "ai-context/**",
    "docs/**",
    "plans/**",
    "scripts/portable-runtime/docs/layered-docs/generated/**",
    "scripts/portable-runtime/evidence/**"
  ],
  "rules": {
    "eslint/no-console": ["error", { "allow": ["warn", "error"] }],
    "eslint/no-cond-assign": "error",
    "eslint/no-debugger": "error",
    "eslint/no-fallthrough": "error",
    "eslint/no-self-compare": "error",
    "eslint/no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_",
        "caughtErrors": "none",
        "ignoreRestSiblings": true,
        "varsIgnorePattern": "^_"
      }
    ],
    "typescript/no-base-to-string": "off",
    "typescript/no-meaningless-void-operator": "off",
    "typescript/no-misused-spread": "off",
    "typescript/require-array-sort-compare": "off",
    "typescript/restrict-template-expressions": "off",
    "typescript/unbound-method": "off",
    "typescript/await-thenable": "error",
    "typescript/no-array-delete": "error",
    "typescript/no-duplicate-type-constituents": "error",
    "typescript/no-floating-promises": "error",
    "typescript/no-for-in-array": "error",
    "typescript/no-implied-eval": "error",
    "typescript/no-import-type-side-effects": "error",
    "typescript/no-misused-promises": ["error", { "checksVoidReturn": false }],
    "typescript/no-redundant-type-constituents": "error",
    "typescript/restrict-plus-operands": "error",
    "typescript/switch-exhaustiveness-check": [
      "error",
      { "considerDefaultExhaustiveForUnions": true }
    ],
    "typescript/consistent-type-imports": [
      "error",
      {
        "disallowTypeAnnotations": false,
        "fixStyle": "separate-type-imports",
        "prefer": "type-imports"
      }
    ],
    "unicorn/no-useless-spread": "off",
    "unicorn/prefer-node-protocol": "error",
    "unicorn/prefer-number-properties": ["error", { "checkInfinity": false, "checkNaN": false }]
  },
  "overrides": [
    {
      "files": ["**/*.astro", "**/*.svelte", "**/*.vue"],
      "rules": {
        "eslint/no-unused-vars": "off",
        "typescript/consistent-type-imports": "off"
      }
    },
    {
      "files": [
        "**/*.svelte",
        "**/*.svelte.ts",
        "packages/svelte/src/**",
        "apps/svelte-demo/src/**"
      ],
      "rules": {
        "eslint/no-unused-expressions": "off"
      }
    },
    {
      "files": [
        "scripts/portable-runtime/contracts/**",
        "scripts/portable-runtime/renderers/**",
        "scripts/portable-runtime/tests/**"
      ],
      "rules": {
        "unicorn/no-thenable": "off"
      }
    },
    {
      "files": ["**/tests/**", "**/*.test.*"],
      "rules": {
        "import/namespace": "off",
        "typescript/no-implied-eval": "off",
        "typescript/no-redundant-type-constituents": "off"
      }
    },
    {
      "files": ["packages/react/tests/**"],
      "rules": {
        "typescript/await-thenable": "off"
      }
    },
    {
      "files": ["**/env.d.ts"],
      "rules": {
        "typescript/triple-slash-reference": "off"
      }
    },
    {
      "files": [
        "apps/**",
        "scripts/**",
        "packages/cli/**",
        "**/tests/**",
        "**/*.test.*",
        "**/*.mjs"
      ],
      "rules": {
        "eslint/no-console": "off"
      }
    }
  ]
}

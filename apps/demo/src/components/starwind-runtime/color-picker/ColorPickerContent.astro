---
import type { ComponentProps } from "astro/types";
import type { VariantProps } from "tailwind-variants";

import "./styles.css";
import { PopoverContent } from "../popover";
import ColorPickerDefaultEditor from "./ColorPickerDefaultEditor.astro";
import { colorPickerContent } from "./variants";

type Props = ComponentProps<typeof PopoverContent> &
  VariantProps<typeof colorPickerContent> & {
    showEyeDropper?: boolean;
    formatControl?: "select" | "native" | "none";
    formats?: readonly import("@starwind-ui/astro/color-picker").ColorPickerFormat[];
    swatches?: readonly (
      | import("@starwind-ui/astro/color-picker").ColorPickerValue
      | {
          value: import("@starwind-ui/astro/color-picker").ColorPickerValue;
          label: string;
          disabled?: boolean;
        }
    )[];
    initial?: import("@starwind-ui/astro/color-picker").ColorPickerRenderProjection;
  };

const {
  initial,
  class: className,
  size = "md",
  showEyeDropper = true,
  formatControl = "select",
  formats = ["hex", "rgb", "hsl", "hsb"],
  swatches = [],
  side = "bottom",
  align = "start",
  exitMotion = "fade",
  ...rest
} = Astro.props;
---

<PopoverContent
  class={colorPickerContent({ size, class: className })}
  side={side}
  align={align}
  collisionStrategy="best-fit"
  exitMotion={exitMotion}
  {...rest}
  data-sw-color-picker-content=""
  data-size={size}
  data-slot="color-picker-content"
>
  <slot>
    <ColorPickerDefaultEditor
      initial={initial}
      size={size}
      showEyeDropper={showEyeDropper}
      formatControl={formatControl}
      formats={formats}
      swatches={swatches}
    />
  </slot>
</PopoverContent>

---
import ColorPicker from "@tabler/icons/outline/color-picker.svg";

import ColorPickerArea from "./ColorPickerArea.astro";
import ColorPickerChannelSlider from "./ColorPickerChannelSlider.astro";
import ColorPickerClear from "./ColorPickerClear.astro";
import ColorPickerEyeDropper from "./ColorPickerEyeDropper.astro";
import ColorPickerInput from "./ColorPickerInput.astro";
import ColorPickerSwatch from "./ColorPickerSwatch.astro";
import ColorPickerSwatchGroup from "./ColorPickerSwatchGroup.astro";
import {
  colorPickerSeparator,
  colorPickerSliderActionRow,
  colorPickerSliders,
  colorPickerValueFormatRow,
} from "./variants";

type Props = {
  size?: "sm" | "md" | "lg";
  showEyeDropper?: boolean;
  portalContainer?: string;
  disablePortal?: boolean;
  formatControl?: "select" | "native" | "none";
  formats?: readonly import("@starwind-ui/astro/color-picker").ColorPickerFormat[];
  swatches?: readonly (
    | import("@starwind-ui/astro/color-picker").ColorPickerValue
    | {
        value: import("@starwind-ui/astro/color-picker").ColorPickerValue;
        label: string;
        disabled?: boolean;
      }
  )[];
  initial?: import("@starwind-ui/astro/color-picker").ColorPickerRenderProjection;
};

const {
  initial,
  size = "md",
  showEyeDropper = true,
  portalContainer,
  disablePortal = false,
  formatControl = "select",
  formats = ["hex", "rgb", "hsl", "hsb"],
  swatches = [],
} = Astro.props;

const isSwatchDescriptor = (
  swatch: (typeof swatches)[number],
): swatch is Extract<(typeof swatches)[number], { value: unknown }> =>
  typeof swatch === "object" && swatch !== null && "value" in swatch && "label" in swatch;
const normalizedSwatches = swatches.map((swatch) =>
  isSwatchDescriptor(swatch)
    ? swatch
    : { value: swatch, label: String(swatch), disabled: undefined },
);
const hasSwatchesAttribute = normalizedSwatches.length > 0 ? "true" : "false";
---

<ColorPickerArea initial={initial?.area()} />

<div class={colorPickerSliderActionRow()} data-slot="color-picker-slider-action-row">
  <div class={colorPickerSliders({ class: "min-w-0 flex-1" })} data-slot="color-picker-sliders">
    <ColorPickerChannelSlider initial={initial} channel="hue" />

    <ColorPickerChannelSlider initial={initial} channel="alpha" />
  </div>

  {
    showEyeDropper && (
      <ColorPickerEyeDropper
        initial={initial?.eyeDropperTrigger.initial}
        aria-label="Pick a color from the screen"
      >
        <ColorPicker class="size-4" aria-hidden="true" />
      </ColorPickerEyeDropper>
    )
  }
</div>

<div class={colorPickerValueFormatRow()} data-slot="color-picker-value-format-row">
  <ColorPickerInput
    initial={initial}
    formatContentSize={size}
    formatControl={formatControl}
    formats={formats}
    portalContainer={portalContainer}
    disablePortal={disablePortal}
    class="min-w-0 flex-1"
  />
</div>

<div class="contents" data-has-swatches={hasSwatchesAttribute} data-slot="color-picker-footer">
  <div
    class={colorPickerSeparator()}
    role="separator"
    aria-hidden="true"
    data-slot="color-picker-separator"
  >
  </div>

  {
    normalizedSwatches.length > 0 && (
      <ColorPickerSwatchGroup initial={initial?.swatchGroup.initial} aria-label="Suggested colors">
        {normalizedSwatches.map((swatch) => (
          <ColorPickerSwatch
            initial={initial}
            value={swatch.value}
            disabled={swatch.disabled}
            aria-label={swatch.label}
          />
        ))}
      </ColorPickerSwatchGroup>
    )
  }

  <ColorPickerClear initial={initial?.clear.initial} aria-label="Clear color">
    Clear
  </ColorPickerClear>
</div>

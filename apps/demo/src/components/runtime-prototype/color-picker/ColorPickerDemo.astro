---
import {
  ColorPicker,
  ColorPickerArea,
  ColorPickerContent,
  ColorPickerInput,
  ColorPickerTrigger,
} from "@/components/starwind-runtime/color-picker";

const swatches = [
  { label: "Red", value: "#ef4444" },
  { label: "Amber", value: "#f59e0b" },
  { label: "Emerald", value: "#10b981" },
  { label: "Sky", value: "#0ea5e9" },
  { label: "Violet", value: "#8b5cf6" },
] as const;

const sizes = [
  { label: "Small", size: "sm", value: "#ef4444" },
  { label: "Medium", size: "md", value: "#10b981" },
  { label: "Large", size: "lg", value: "#8b5cf6" },
] as const;

const anatomy = [
  ["Complete picker", "ColorPicker"],
  ["Popup shell", "ColorPickerTrigger + ColorPickerContent"],
  ["Color surface", "ColorPickerArea"],
  ["Channels", "ColorPickerChannelSlider + ColorPickerChannelInput"],
  ["Exact editing", "ColorPickerInput"],
  ["Actions", "ColorPickerEyeDropper + ColorPickerClear"],
  ["Consumer colors", "ColorPickerSwatchGroup + ColorPickerSwatch"],
  ["Form value", "Automatically rendered by ColorPicker"],
] as const;
---

<section class="mb-12 space-y-4" data-testid="canonical-docs-color-picker">
  <header class="space-y-1">
    <div
      class="bg-primary text-primary-foreground inline-flex rounded-full px-3 py-1 text-xs font-semibold tracking-wide uppercase"
    >
      Canonical docs example
    </div>
    <h2 class="font-heading text-2xl font-semibold">Simple common usage</h2>
    <p class="text-muted-foreground max-w-3xl">
      With no children, ColorPicker supplies the complete popup editor and its hidden form input.
    </p>
  </header>

  <div class="bg-card rounded-xl border p-6 shadow-sm">
    <div class="w-full max-w-sm" data-color-picker-example="default">
      <ColorPicker
        id="runtime-prototype-docs-canonical-color-picker"
        label="Brand color"
        name="brand-color"
        defaultValue="#ff000080"
        swatches={swatches}
      />
    </div>
  </div>
</section>

<section class="mb-12 space-y-3" data-testid="canonical-color-picker">
  <header class="flex flex-wrap items-baseline gap-x-4 gap-y-1">
    <h2 class="font-heading text-2xl font-semibold">Color Picker</h2>
    <p class="text-muted-foreground max-w-3xl">
      Convenience props handle common customization; children remain an escape hatch.
    </p>
  </header>

  <div class="grid items-start gap-6 lg:grid-cols-[minmax(0,1fr)_minmax(18rem,0.8fr)]">
    <div class="bg-card space-y-4 rounded-xl border p-3 shadow-sm">
      <ColorPicker
        id="canonical-color-picker-root"
        label="Brand color"
        defaultValue="rgba(255, 0, 0, 0.5)"
        clearable
        swatches={swatches}
        name="canonicalColor"
      >
        {
          (initial) => (
            <Fragment>
              <span class="text-sm font-medium">Brand color</span>
              <div class="flex items-center gap-2" data-slot="color-picker-control">
                <ColorPickerTrigger
                  initial={initial}
                  aria-label="Open canonical brand color picker"
                  data-testid="canonical-color-picker-trigger"
                />
              </div>
              <ColorPickerContent
                initial={initial}
                swatches={swatches}
                avoidCollisions={false}
                aria-label="Canonical brand color editor"
                data-testid="canonical-color-picker-content"
              />
            </Fragment>
          )
        }
      </ColorPicker>
      <p class="text-muted-foreground text-sm">
        Clear and the suggested palette are enabled by data props on the complete editor.
      </p>
    </div>

    <div class="bg-card space-y-4 rounded-xl border p-3 shadow-sm">
      <h3 class="font-heading text-base font-semibold">Native format control</h3>
      <p class="text-muted-foreground text-sm">
        The inline shell can use a native selector and a restricted format list.
      </p>
      <ColorPicker
        id="canonical-native-color-picker"
        inline
        defaultValue="rgb(37, 99, 235)"
        format="rgb"
        formats={["rgb", "hex"]}
        formatControl="native"
        alpha={false}
        showEyeDropper={false}
        data-testid="canonical-native-color-picker"
      >
        {
          (initial) => (
            <Fragment>
              <span class="text-sm font-medium">Accent color</span>
              <ColorPickerInput
                initial={initial}
                formatControl="native"
                formats={["rgb", "hex"]}
                data-testid="canonical-native-color-picker-input"
              />
            </Fragment>
          )
        }
      </ColorPicker>
    </div>
  </div>

  <div class="bg-card space-y-4 rounded-xl border p-5 shadow-sm">
    <div class="space-y-1">
      <h3 class="font-heading text-base font-semibold">Swatch-only trigger</h3>
      <p class="text-muted-foreground text-sm">
        Custom children replace the visible default, while the hidden input remains automatic.
      </p>
    </div>
    <ColorPicker defaultValue="#0ea5e9" alpha={false} name="swatchOnlyColor">
      {
        (initial) => (
          <Fragment>
            <span class="text-sm font-medium">Swatch-only color</span>
            <ColorPickerTrigger
              initial={initial}
              showValueText={false}
              class="size-11 p-2"
              aria-label="Open swatch-only color picker"
              data-testid="canonical-color-picker-swatch-trigger"
            />
            <ColorPickerContent
              initial={initial}
              showEyeDropper={false}
              aria-label="Swatch-only color editor"
            />
          </Fragment>
        )
      }
    </ColorPicker>
  </div>

  <div class="space-y-3" data-testid="canonical-color-picker-sizes">
    <h3 class="font-heading text-base font-semibold">Starwind size scale</h3>
    <div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
      {
        sizes.map(({ label, size, value }) => (
          <div class="bg-card rounded-xl border p-4">
            <ColorPicker defaultValue={value} alpha={false} size={size}>
              {(initial) => (
                <Fragment>
                  <span class="text-sm font-medium">{label}</span>
                  <div data-slot="color-picker-control">
                    <ColorPickerTrigger
                      initial={initial}
                      aria-label={`Open ${label.toLowerCase()} color picker`}
                      data-testid={`canonical-color-picker-${size}-trigger`}
                    />
                  </div>
                  <ColorPickerContent
                    initial={initial}
                    size={size}
                    showEyeDropper={false}
                    swatches={[{ value, label: `${label} sample swatch` }]}
                    aria-label={`${label} color editor`}
                  />
                </Fragment>
              )}
            </ColorPicker>
          </div>
        ))
      }
      <div class="bg-card rounded-xl border p-4">
        <ColorPicker defaultValue="#0ea5e9" alpha={false} size="sm">
          {
            (initial) => (
              <Fragment>
                <span class="text-sm font-medium">Independent popup</span>
                <div data-slot="color-picker-control">
                  <ColorPickerTrigger
                    initial={initial}
                    aria-label="Open independently sized color picker"
                    data-testid="canonical-color-picker-mismatch-trigger"
                  />
                </div>
                <ColorPickerContent
                  initial={initial}
                  size="lg"
                  aria-label="Large custom color editor"
                  data-testid="canonical-color-picker-mismatch-content"
                >
                  <ColorPickerArea initial={initial?.area()} />
                  <ColorPickerInput
                    initial={initial}
                    formatContentSize="sm"
                    data-testid="canonical-color-picker-format-popup-sm"
                  />
                </ColorPickerContent>
              </Fragment>
            )
          }
        </ColorPicker>
      </div>
    </div>
  </div>

  <div class="space-y-3" aria-labelledby="color-picker-anatomy-heading">
    <h3 id="color-picker-anatomy-heading" class="font-heading text-base font-semibold">
      Public anatomy
    </h3>
    <dl class="bg-border grid gap-px overflow-hidden rounded-xl border sm:grid-cols-2">
      {
        anatomy.map(([label, components]) => (
          <div class="bg-card grid gap-1 p-4">
            <dt class="font-medium">{label}</dt>
            <dd class="text-muted-foreground font-mono text-xs leading-relaxed">{components}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

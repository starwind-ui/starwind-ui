---
import type { HTMLTag, Polymorphic } from "astro/types";
import type { VariantProps } from "tailwind-variants";

import { aspectRatio } from "./variants";

type Props<Tag extends HTMLTag> = Polymorphic<{ as: Tag }> &
  VariantProps<typeof aspectRatio> & {
    ratio?: number;
  };

const { ratio = 1, as: Tag = "div", class: className, style, ...rest } = Astro.props;

const ratioStyle =
  typeof style === "string" ? `--ratio: ${ratio}; ${style}` : { "--ratio": ratio, ...style };
---

<Tag
  {...rest}
  class={aspectRatio({ class: className })}
  style={ratioStyle}
  data-slot="aspect-ratio"
>
  <slot />
</Tag>

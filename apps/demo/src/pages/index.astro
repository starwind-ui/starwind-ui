---
import { componentDemos } from "@/components/runtime-prototype/sections";
import Layout from "@/layouts/Layout.astro";
---

<Layout
  title="Starwind UI Astro Components"
  description="Starwind UI components for Astro backed by the portable Runtime"
>
  <div class="container mx-auto max-w-4xl px-4 py-12">
    <div class="mb-10 space-y-3">
      <h1 class="font-heading text-4xl font-semibold tracking-tight">Starwind UI components</h1>
      <p class="text-muted-foreground max-w-2xl">
        Generated styled Astro components backed by Starwind Runtime. Use this page to review and
        test the current component set. The LTR/RTL button in the header switches the reading
        direction for the whole page.
      </p>
    </div>

    <nav aria-label="Components on this page" class="mb-12 flex flex-wrap gap-2">
      {
        componentDemos.map(({ id, label }) => (
          <a
            href={`#${id}`}
            class="bg-muted text-muted-foreground hover:text-foreground rounded-md px-2.5 py-1 text-sm transition-colors"
          >
            {label}
          </a>
        ))
      }
    </nav>

    {
      componentDemos.map(({ id, component: Demo }) => (
        <div id={id} class="scroll-mt-20">
          <Demo />
        </div>
      ))
    }
  </div>
</Layout>

---
import ChartExamples from "@/components/demos/chart/ChartExamples.astro";
import Layout from "@/layouts/Layout.astro";
---

<Layout
  title="Runtime Charts"
  description="Astro Runtime chart examples for review and smoke tests"
>
  <main class="container mx-auto max-w-5xl px-4 py-12">
    <header class="mb-10 space-y-3">
      <p class="text-muted-foreground text-sm font-medium tracking-wide uppercase">
        Runtime component review
      </p>
      <h1 class="font-heading text-4xl font-semibold tracking-tight">Charts</h1>
      <p class="text-muted-foreground max-w-3xl">
        Review the bar, area, donut and radar examples in light and dark mode. Move the pointer over
        a chart or focus it and use the arrow keys to see the tooltip. Click a legend item to hide
        or show its series.
      </p>
      <a class="text-sm font-medium underline underline-offset-4" href="/runtime-charts/area/">
        Open the chart gallery
      </a>
      <a class="text-sm font-medium underline underline-offset-4" href="/runtime-chart-parts/">
        Open the chart parts examples
      </a>
    </header>
    <ChartExamples />
  </main>
</Layout>

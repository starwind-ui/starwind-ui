{
  "name": "svelte-demo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter=@starwind-ui/runtime build && pnpm --filter=@starwind-ui/svelte build && vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "node tests/review.test.mjs",
    "format": "prettier --plugin=prettier-plugin-svelte --write . --ignore-unknown"
  },
  "dependencies": {
    "@starwind-ui/svelte": "workspace:*",
    "@tailwindcss/forms": "0.5.11",
    "tailwind-merge": "3.6.0",
    "tailwind-variants": "3.2.2",
    "tailwindcss": "4.3.0",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "3.0.10",
    "@sveltejs/kit": "2.70.3",
    "@sveltejs/vite-plugin-svelte": "6.2.1",
    "@tailwindcss/vite": "4.3.0",
    "@types/node": "24.12.4",
    "playwright": "1.62.0",
    "prettier": "3.8.3",
    "prettier-plugin-svelte": "3.4.1",
    "svelte": "5.29.0",
    "svelte-check": "4.4.8",
    "typescript": "5.9.3",
    "vite": "7.3.5"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}

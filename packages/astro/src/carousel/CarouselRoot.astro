import type { CarouselOptions } from "@starwind-ui/runtime/carousel";
import type { HTMLAttributes } from "astro/types";

type Props = HTMLAttributes<"div"> & {
  orientation?: "horizontal" | "vertical";
  opts?: CarouselOptions["opts"];
  autoInit?: boolean;
};

const { orientation = "horizontal", opts = {}, autoInit = true, ...rest } = Astro.props;
---

<div
  data-sw-carousel
  role="region"
  aria-roledescription="carousel"
  data-axis={orientation === "vertical" ? "y" : "x"}
  data-opts={JSON.stringify(opts)}
  data-auto-init={autoInit ? undefined : "false"}
  {...rest}
>
  <slot />
</div>

<script>
  import { createCarousel } from "@starwind-ui/runtime/carousel";
  import {
    registerAstroControllerLifecycle,
    trackAstroController,
  } from "../internal/controller-lifecycle";

  import { getAstroInitCandidates as getInitCandidates } from "../internal/controller-lifecycle";

  const setupCarousels = (event?: Event) => {
    getInitCandidates(event, "[data-sw-carousel]").forEach((root) => {
      if (root.getAttribute("data-auto-init") === "false") return;

      trackAstroController("CarouselRoot", root, createCarousel(root));
    });
  };

  registerAstroControllerLifecycle("CarouselRoot", setupCarousels);
</script>

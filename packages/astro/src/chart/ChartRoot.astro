---
/**
 * Generated by scripts/portable-runtime/generate-astro-wrappers.ts.
 * Do not edit by hand; update the contract/template instead.
 */
import {
  assertChartId,
  createChartId,
  serializeChartPayload,
  visibleKeys,
} from "@starwind-ui/runtime/chart";
import ChartLifecycle from "./ChartLifecycle.astro";
import {
  type ChartRootProps,
  type ChartValue,
  chartViewTemplates,
  collectChartViews,
  renderChartContent,
} from "./ChartMarkup";

type Props<
  T = unknown,
  D = unknown,
  X extends ChartValue = ChartValue,
  Y extends ChartValue = ChartValue,
> = ChartRootProps<T, D, X, Y>;

const {
  id = createChartId(),
  chart,
  definition,
  data = [],
  config,
  params,
  theme,
  host,
  disableTooltip = false,
  interactive = true,
  labels: labelsProp,
  icons: iconsProp,
  visible: visibleProp,
  defaultVisible,
  // The part owns its data-slot, as in every framework.
  "data-slot": _dataSlot,
  ...rest
} = Astro.props;

assertChartId(id);
const mode = definition ? "definition" : "source";
if (mode === "definition" && (visibleProp !== undefined || defaultVisible !== undefined)) {
  throw new TypeError(
    "Static native definitions own their visibility. Remove visible and defaultVisible, or use a chart factory.",
  );
}
const visible = visibleKeys(config, visibleProp ?? defaultVisible);
const input = {
  data,
  config,
  ...(mode === "source" ? { visible } : {}),
  ...(params ? { params } : {}),
  ...(theme ? { theme } : {}),
};
const moduleId = typeof chart === "object" && chart !== null ? chart.id : undefined;
// Only a registered chart module starts from the lifecycle script. Other interactive charts start
// from a page script that calls createChart.
const lifecycle = interactive && moduleId !== undefined;

const { labels, icons } = await collectChartViews(Astro.slots, config, labelsProp, iconsProp);
const content = Astro.slots.has("default") ? await Astro.slots.render("default") : "";
const html = renderChartContent(content, {
  id,
  chart,
  definition,
  input,
  host,
  disableTooltip,
  legend: {
    config,
    visible,
    interactive: interactive && mode === "source",
    template: interactive,
    labels,
    icons,
  },
});
const templates = interactive ? chartViewTemplates(config, labels, icons) : "";
const payload = interactive
  ? serializeChartPayload({ input, host, tooltipDisabled: disableTooltip })
  : "";
---

<div
  {...rest}
  data-slot="chart"
  data-chart={id}
  data-chart-module={moduleId}
  data-sw-chart={lifecycle ? "" : undefined}
  data-state={interactive ? "pending" : "static"}
>
  <Fragment set:html={html + templates} />
  {
    interactive && (
      <script is:inline type="application/json" data-sw-chart-input set:html={payload} />
    )
  }
  {lifecycle && <ChartLifecycle />}
</div>

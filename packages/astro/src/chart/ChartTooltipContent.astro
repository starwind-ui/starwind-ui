---
/**
 * Generated by scripts/portable-runtime/generate-astro-wrappers.ts.
 * Do not edit by hand; update the contract/template instead.
 */
import { type ChartTooltipContentProps, extractChartTooltipIconClass } from "./ChartMarkup";

type Props = ChartTooltipContentProps;

const {
  indicator,
  hideLabel,
  hideIndicator,
  label,
  labelKey,
  nameKey,
  valueKey,
  color,
  // The part owns its data-slot, as in every framework.
  "data-slot": _dataSlot,
  ...rest
} = Astro.props;

const children = Astro.slots.has("default") ? await Astro.slots.render("default") : "";
const { html, iconClass } = extractChartTooltipIconClass(children);
// The Runtime fills this template for each tooltip body. Formatters come from the chart module's
// `domPresentation`, because functions cannot travel from the server.
const options = Object.fromEntries(
  Object.entries({
    indicator,
    hideLabel,
    hideIndicator,
    label,
    labelKey,
    nameKey,
    valueKey,
    color,
    iconClass,
  }).filter(([, value]) => value !== undefined),
);
---

<template data-sw-chart-tooltip data-sw-chart-tooltip-options={JSON.stringify(options)}>
  <div {...rest} data-slot="chart-tooltip-content" data-indicator={indicator ?? "dot"}>
    <Fragment set:html={html} />
  </div>
</template>

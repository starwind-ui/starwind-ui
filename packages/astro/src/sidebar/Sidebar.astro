---
/**
 * Generated by scripts/portable-runtime/generate-astro-wrappers.ts.
 * Do not edit by hand; update the contract/template instead.
 */
import type { HTMLAttributes } from "astro/types";

type Props = HTMLAttributes<"div"> & {
  side?: "left" | "right";
  variant?: "sidebar" | "floating" | "inset";
  collapsible?: "offcanvas" | "icon";
};

const { side = "left", variant = "sidebar", collapsible = "offcanvas", ...rest } = Astro.props;

// SidebarProvider records its initial state before its slot renders. When providers on one page
// have different initial states, keep "expanded" and let the Runtime apply the state.
// Render the Sidebar inside its SidebarProvider slot. A Sidebar that you render before its provider,
// for example with `Astro.slots.render`, can show the wrong state until the page script starts.
const sidebarInitialStates = (
  Astro.locals as unknown as Record<symbol, Set<string> | undefined> | undefined
)?.[Symbol.for("starwind-ui.sidebar.initial-states")];
const state =
  sidebarInitialStates?.size === 1 && sidebarInitialStates.has("collapsed")
    ? "collapsed"
    : "expanded";

const sidebarAttributes = Object.fromEntries(
  Object.entries(rest).filter(
    ([name]) =>
      ![
        "data-sw-sidebar",
        "data-state",
        "data-collapsible",
        "data-collapsible-mode",
        "data-variant",
        "data-side",
      ].includes(name),
  ),
);
---

<div
  data-sw-sidebar
  data-state={state}
  data-collapsible={state === "collapsed" ? collapsible : ""}
  data-collapsible-mode={collapsible}
  data-variant={variant}
  data-side={side}
  {...sidebarAttributes}
>
  <slot />
</div>

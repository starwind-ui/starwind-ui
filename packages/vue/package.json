{
  "name": "@starwind-ui/vue",
  "version": "0.1.1",
  "description": "Public-beta Vue 3.5 Primitive adapters for Starwind UI, powered by the shared framework-neutral Runtime.",
  "license": "MIT",
  "homepage": "https://starwind.dev/",
  "author": {
    "name": "boston343",
    "url": "https://x.com/boston343builds"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/starwind-ui/starwind-ui.git",
    "directory": "packages/vue"
  },
  "bugs": {
    "url": "https://github.com/starwind-ui/starwind-ui/issues"
  },
  "keywords": [

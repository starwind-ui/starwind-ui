{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "allowJs": true,
    "baseUrl": ".",
    "checkJs": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "paths": {
      "@starwind-ui/runtime": ["../runtime/src/index.ts"],
      "@starwind-ui/runtime/*": ["../runtime/src/components/*/index.ts"],
      "@starwind-ui/svelte": ["src/index.ts"],
      "@starwind-ui/svelte/*": ["src/*/index.ts"]
    },
    "types": ["node", "svelte"]
  },
  "include": ["src/**/*.ts", "src/**/*.svelte", "tests/**/*.ts"],
  "exclude": ["dist", "node_modules"]
}

{
  "name": "@starwind-ui/svelte",
  "version": "0.0.0",
  "private": true,
  "description": "Internal non-shipping Svelte primitive adapter verification package",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "svelte": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./button": {
      "types": "./dist/button/index.d.ts",
      "svelte": "./dist/button/index.js",
      "default": "./dist/button/index.js"
    },
    "./carousel": {
      "types": "./dist/carousel/index.d.ts",
      "svelte": "./dist/carousel/index.js",
      "default": "./dist/carousel/index.js"
    },
    "./checkbox": {
      "types": "./dist/checkbox/index.d.ts",
      "svelte": "./dist/checkbox/index.js",
      "default": "./dist/checkbox/index.js"
    },
    "./select": {
      "types": "./dist/select/index.d.ts",
      "svelte": "./dist/select/index.js",
      "default": "./dist/select/index.js"
    },
    "./accordion": {
      "types": "./dist/accordion/index.d.ts",
      "svelte": "./dist/accordion/index.js",
      "default": "./dist/accordion/index.js"
    },
    "./dialog": {
      "types": "./dist/dialog/index.d.ts",
      "svelte": "./dist/dialog/index.js",
      "default": "./dist/dialog/index.js"
    },
    "./slider": {
      "types": "./dist/slider/index.d.ts",
      "svelte": "./dist/slider/index.js",
      "default": "./dist/slider/index.js"
    },
    "./toast": {
      "types": "./dist/toast/index.d.ts",
      "svelte": "./dist/toast/index.js",
      "default": "./dist/toast/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "svelte-package -i src -o dist --tsconfig tsconfig.json",
    "test:run": "vitest run --config tests/vitest.config.ts",
    "test:all": "pnpm --filter=@starwind-ui/runtime build && pnpm build && pnpm test:run",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json"
  },
  "dependencies": {
    "@starwind-ui/runtime": "workspace:*"
  },
  "peerDependencies": {
    "svelte": ">=5.29.0"
  },
  "devDependencies": {
    "@sveltejs/package": "2.5.8",
    "@sveltejs/vite-plugin-svelte": "6.2.1",
    "@types/node": "^24.12.4",
    "svelte": "5.29.0",
    "svelte-check": "4.4.8",
    "typescript": "^5.9.3",
    "vite": "7.3.5",
    "vitest": "^4.0.16"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}

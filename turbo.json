{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["**/.env.*local"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "preview": {
      "dependsOn": ["build"]
    },
    "typecheck": {
      "outputs": []
    },
    "svelte-demo#build": {
      "dependsOn": ["^build"],
      "outputs": ["build/**"]
    },
    "svelte-demo#typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "format:check": {
      "outputs": []
    },
    "format:write": {
      "outputs": []
    },
    "clean": {
      "cache": false
    }
  }
}
